{
  "name": "@dimi-agent/cli",
  "version": "0.4.1",
  "description": "The Starting Point for Next-Gen Agents",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "coding-agent",
    "dimi",
    "dimi",
    "tui"
  ],
  "homepage": "https://github.com/zzj3720/dimi/tree/main/apps/dimi#readme",
  "bugs": {
    "url": "https://github.com/zzj3720/dimi/issues"
  },
  "license": "MIT",
  "author": "Moonshot AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzj3720/dimi.git",
    "directory": "apps/dimi"
  },
  "bin": {
    "dimi": "dist/main.mjs"
  },
  "files": [
    "dist",
    "dist-web",
    "native",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#/tui/theme": "./src/tui/theme/index.ts",
    "#/tui/commands": "./src/tui/commands/index.ts",
    "#/cli/sub/web": "./src/cli/sub/web/index.ts",
    "#/cli/sub/web/*": "./src/cli/sub/web/*.ts",
    "#/generated/vis-web-asset": [
      "./src/generated/vis-web-asset.ts",
      "./src/generated/vis-web-asset.d.ts"
    ],
    "#/*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm -C ../dimi-web run build && tsdown && node scripts/copy-native-assets.mjs && node scripts/copy-web-assets.mjs",
    "prebuild": "node scripts/build-vis-asset.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:native:js": "node scripts/native/01-bundle.mjs",
    "build:native:sea": "node scripts/native/build.mjs --profile=local",
    "build:native:release": "node scripts/native/build.mjs --profile=release",
    "package:native": "node scripts/native/package.mjs",
    "produce:native:manifest": "node scripts/native/produce-manifest.mjs",
    "release:native:resolve": "node scripts/native/resolve-release.mjs",
    "test:native:smoke": "node scripts/native/smoke.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:cli-only": "tsx --tsconfig ./tsconfig.dev.json --import ../../build/register-raw-text-loader.mjs ./src/main.ts",
    "dev:server": "DIMI_CODE_DEV_SERVER=1 tsx --tsconfig ./tsconfig.dev.json --import ../../build/register-raw-text-loader.mjs ./src/main.ts web --no-open --debug-endpoints",
    "dev:kap-server": "DIMI_CODE_DEV_SERVER=1 tsx --tsconfig ./tsconfig.dev.json --import ../../build/register-raw-text-loader.mjs ./src/main.ts web --no-open --debug-endpoints",
    "dev:kap-server:multi": "DIMI_CODE_DEV_SERVER=1 tsx --tsconfig ./tsconfig.dev.json --import ../../build/register-raw-text-loader.mjs ./src/main.ts web --no-open --debug-endpoints",
    "dev:server:restart": "node scripts/dev-server-restart.mjs",
    "dev:plugin-marketplace": "node scripts/dev-plugin-marketplace-server.mjs",
    "build:plugin-marketplace": "node scripts/build-plugin-marketplace-cdn.mjs",
    "dev:prod": "node dist/main.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -w run build:packages && vitest run",
    "e2e": "pnpm -w run build:packages && DIMI_E2E=1 vitest run test/e2e",
    "e2e:real": "pnpm -w run build:packages && DIMI_E2E_REAL=1 vitest run test/e2e/real-llm-smoke.e2e.test.ts"
  },
  "devDependencies": {
    "@dimi-agent/agent-core-v2": "workspace:^",
    "@dimi-agent/kap-server": "workspace:^",
    "@dimi-agent/dimi-oauth": "workspace:^",
    "@dimi-agent/dimi-sdk": "workspace:^",
    "@dimi-agent/dimi-telemetry": "workspace:^",
    "@dimi-agent/dimi-web": "workspace:^",
    "@dimi-agent/pi-tui": "workspace:^",
    "@dimi-agent/remote": "workspace:^",
    "@dimi-agent/vis-server": "workspace:^",
    "@dimi-agent/vis-web": "workspace:*",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.7.0",
    "@types/yazl": "^2.4.6",
    "chalk": "^5.4.1",
    "cli-highlight": "^2.1.11",
    "commander": "^13.1.0",
    "jimp": "^1.6.1",
    "pathe": "^2.0.3",
    "postject": "1.0.0-alpha.6",
    "qrcode": "1.5.4",
    "semver": "^7.7.4",
    "smol-toml": "^1.6.1",
    "tsx": "^4.21.0",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@mariozechner/clipboard": "^0.3.9",
    "node-pty": "^1.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
