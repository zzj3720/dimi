{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "k3720-relay-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "relay.k.3720.org",
      "custom_domain": true
    },
    {
      "pattern": "relay.k.test.3720.org",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_ROOMS",
        "class_name": "RelayRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
