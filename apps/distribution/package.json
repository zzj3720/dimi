{
  "name": "@k-3720/distribution",
  "version": "0.1.0",
  "private": true,
  "description": "Internal Android build distribution for k-3720.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "build": "pnpm run assets && wrangler deploy --dry-run --outdir dist",
    "deploy:test": "pnpm run assets && wrangler deploy",
    "publish:android": "node scripts/publish-android.mjs",
    "typecheck": "wrangler types --include-runtime=false --check && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.0",
    "@cloudflare/workers-types": "5.20260731.1",
    "qrcode": "1.5.4",
    "vitest": "4.1.4",
    "wrangler": "4.117.0"
  }
}
