{
  "name": "@dimi-agent/dimi-native",
  "version": "0.1.0",
  "private": true,
  "description": "napi-rs native binding for the dimi Rust runtime (dimi-wire contract mirror), consumed by the TS↔Rust differential harness and the module swap-in socket.",
  "license": "MIT",
  "author": "Moonshot AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzj3720/dimi.git",
    "directory": "packages/dimi-native"
  },
  "bugs": {
    "url": "https://github.com/zzj3720/dimi/issues"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build:native": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@dimi-agent/transcript": "workspace:^"
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "node-pty": "^1.1.0"
  }
}
